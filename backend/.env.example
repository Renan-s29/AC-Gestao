PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha
DB_NAME=ac_gestao

# JWT — use segredo longo e aleatório em produção
JWT_SECRET=troque_este_segredo_em_producao_minimo_32_caracteres
JWT_EXPIRES_IN=8h

# Regras de negócio (opcional; valores padrão no código)
TAXA_ADMINISTRATIVA=40
DIAS_BLOQUEIO_BENEFICIOS=5
DIAS_SUSPENSAO_TOTAL=30
PERCENTUAL_JUROS_DIA=0.0005
PERCENTUAL_MULTA=0.02

# CORS (origens separadas por vírgula)
CORS_ORIGINS=http://localhost:4200
